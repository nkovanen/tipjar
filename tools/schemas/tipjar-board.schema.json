{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "generated_at",
    "expires_at",
    "rules_version",
    "source_commit",
    "coverage",
    "tips",
    "repositories",
    "directory"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "tipjar-board/1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 27,
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z"
    },
    "expires_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 27,
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z"
    },
    "rules_version": {
      "type": "integer",
      "const": 1
    },
    "source_commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "[0-9a-f]{40}"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exhaustive",
        "partial",
        "unknown_tips",
        "unknown_repositories",
        "excluded_tips",
        "excluded_repositories",
        "omitted_tips",
        "omitted_repositories",
        "omitted_directory_observations"
      ],
      "properties": {
        "exhaustive": {
          "type": "boolean",
          "const": false
        },
        "partial": {
          "type": "boolean"
        },
        "unknown_tips": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown_repositories": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "excluded_tips": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "excluded_repositories": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "omitted_tips": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "omitted_repositories": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "omitted_directory_observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "pull_request_id",
          "number",
          "url",
          "author_id",
          "author_login",
          "merged_at",
          "checks",
          "verified_at",
          "submission_url",
          "agent_assistance",
          "size"
        ],
        "properties": {
          "repository_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "pull_request_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "author_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "author_login": {
            "type": "string",
            "minLength": 1,
            "maxLength": 39,
            "pattern": "[A-Za-z0-9][A-Za-z0-9-]{0,38}"
          },
          "merged_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 27,
            "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z"
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "consent",
              "controller",
              "repository",
              "pull_request"
            ],
            "properties": {
              "consent": {
                "type": "string",
                "minLength": 1,
                "maxLength": 27,
                "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z"
              },
              "controller": {
                "type": "string",
                "minLength": 1,
                "maxLength": 27,
                "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z"
              },
              "repository": {
                "type": "string",
                "minLength": 1,
                "maxLength": 27,
                "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z"
              },
              "pull_request": {
                "type": "string",
                "minLength": 1,
                "maxLength": 27,
                "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z"
              }
            }
          },
          "verified_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 27,
            "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z"
          },
          "submission_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "https://github\\.com/nkovanen/tipjar/issues/[1-9][0-9]{0,15}"
          },
          "agent_assistance": {
            "type": "string",
            "const": "self-declared"
          },
          "size": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "additions",
              "deletions",
              "changed_files"
            ],
            "properties": {
              "additions": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "deletions": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "changed_files": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "maxItems": 500
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "repository",
          "primary_language",
          "verified_at"
        ],
        "properties": {
          "repository_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}"
          },
          "primary_language": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "verified_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 27,
            "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z"
          }
        }
      },
      "maxItems": 200
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "search_failed",
        "server_incomplete",
        "truncated",
        "observations"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "search_failed": {
          "type": "boolean"
        },
        "server_incomplete": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository_id",
              "repository",
              "disposition",
              "verified_at",
              "checks",
              "jar",
              "source"
            ],
            "properties": {
              "repository_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "repository": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}"
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "welcome",
                  "closed",
                  "undeclared",
                  "unknown",
                  "excluded"
                ]
              },
              "verified_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 27,
                "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z"
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 27,
                  "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z"
                },
                "maxItems": 32,
                "minItems": 2
              },
              "jar": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/jar_result"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "path",
                      "commit",
                      "sha256"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "manifest"
                      },
                      "path": {
                        "type": "string",
                        "const": ".tipjar.json"
                      },
                      "commit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40,
                        "pattern": "[0-9a-f]{40}"
                      },
                      "sha256": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "[0-9a-f]{64}"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 200
        }
      }
    }
  },
  "$defs": {
    "tipjar_manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "status": {
          "type": "string",
          "enum": [
            "welcome",
            "closed"
          ]
        },
        "wanted": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          }
        },
        "boundaries": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "status"
      ],
      "additionalProperties": false
    },
    "api_budget": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "after": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "used_during_command": {
          "type": [
            "integer",
            "null"
          ],
          "description": "after.used - before.used; null when the snapshots cannot be compared"
        },
        "delta_unknown_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why used_during_command is null",
          "maxLength": 2147483647
        },
        "note": {
          "type": "string",
          "maxLength": 2147483647
        }
      },
      "required": [
        "before",
        "after",
        "used_during_command",
        "delta_unknown_reason",
        "note"
      ],
      "additionalProperties": false,
      "description": "Added by --report-budget; report only"
    },
    "rate_limit_snapshot": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Reset time, epoch seconds"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the snapshot failed; null when it succeeded",
          "maxLength": 2147483647
        }
      },
      "required": [
        "limit",
        "remaining",
        "used",
        "reset",
        "error"
      ],
      "additionalProperties": false,
      "description": "Core REST rate-limit snapshot; the counters are null when error is set"
    },
    "jar_result": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 200,
          "description": "Actual repository inspected; no parent or owner inheritance"
        },
        "default_branch": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
        },
        "path": {
          "type": "string",
          "const": ".tipjar.json"
        },
        "blob_sha": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "description": "Exact decoded-byte digest, even when validation fails; not by itself trusted provenance"
        },
        "fetched_at": {
          "type": "string",
          "maxLength": 100
        },
        "state": {
          "type": "string",
          "enum": [
            "welcome",
            "closed",
            "undeclared",
            "unknown"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/tipjar_manifest"
            },
            {
              "type": "null"
            }
          ]
        },
        "errors": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "notice": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "repository",
        "default_branch",
        "commit",
        "path",
        "blob_sha",
        "sha256",
        "fetched_at",
        "state",
        "complete",
        "manifest",
        "errors",
        "notice"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tipjar:tipjar-board:1",
  "description": "Closed source-only board contract. Cross-field identities, safe integers, actual timestamps, minimum checks, and exact 48-hour expiry require semantic validation; JSON byte caps also apply."
}
