include AGENTS.md CONTRIBUTING.md SECURITY.md CHANGELOG.md
include tools/check_install.py tools/output_reference.py tools/release_check.py tools/compose_schemas.py
recursive-include tools/benchmark *.py *.md
include .github/workflows/ci.yml
recursive-include docs *.md
recursive-include tests *.py *.json *.md
recursive-include actions *.py *.yml
include docs/examples/*.yml
include tests/fixtures/dependencies/requirements.txt
recursive-include web *.html *.css *.js *.svg *.md
recursive-include tests/web *.cjs *.html *.js
include tools/tipjar_board.py tools/tipjar_board_deploy.py tools/tipjar_board_intake.py
include tools/schemas/tipjar-board.schema.json tools/schemas/tipjar-board-registry.schema.json
include docs/examples/tipjar-board-registry.json
include docs/examples/tipjar-board-pages.yml.disabled docs/examples/submit-tip.yml.disabled
