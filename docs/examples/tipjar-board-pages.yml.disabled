# INERT: controller activates only after review, Pages setup and environment protection.
name: Tipjar Pages

on:
  schedule:
    - cron: '23 6 * * *'
  workflow_dispatch:
    inputs:
      bootstrap:
        description: 'Controller first publication only: permit an HTTP 404 board'
        required: false
        default: false
        type: boolean

permissions: {}

# Every publisher for this site must use this exact group. Ordering is not guaranteed.
concurrency:
  group: tipjar-pages
  cancel-in-progress: false

jobs:
  build:
    if: >-
      github.repository == 'nkovanen/tipjar' &&
      github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
    env:
      GH_TOKEN: ${{ github.token }}
      SOURCE_COMMIT: ${{ github.sha }}
    outputs:
      source_commit: ${{ github.sha }}
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.12'
      - name: Collect fresh public observations
        run: >-
          python3 tools/tipjar_board.py
          --registry docs/examples/tipjar-board-registry.json
          --output "$RUNNER_TEMP/board.json"
          --source-commit "$SOURCE_COMMIT"
          --controller-id 1444643470
      - name: Assemble static site and trusted predeploy bundle
        run: |
          python3 - <<'PY'
          from pathlib import Path
          import os
          import shutil
          site = Path('_site')
          shutil.copytree('web', site)
          shutil.copyfile(Path(os.environ['RUNNER_TEMP']) / 'board.json', site / 'board.json')
          bundle = Path('_predeploy')
          (bundle / 'tools').mkdir(parents=True)
          for name in ('tipjar_board.py', 'tipjar_board_deploy.py'):
              shutil.copyfile(Path('tools') / name, bundle / 'tools' / name)
          shutil.copytree('tools/schemas', bundle / 'tools/schemas')
          shutil.copytree('agent_contribute', bundle / 'agent_contribute',
                          ignore=shutil.ignore_patterns('__pycache__', '*.pyc'))
          PY
          python3 tools/tipjar_board_deploy.py --board _site/board.json --source-commit "$SOURCE_COMMIT"
          tar --dereference --hard-dereference --directory _site --exclude=.git --exclude=.github --create --file "$RUNNER_TEMP/artifact.tar" .
      # Same artifact.tar layout as upload-pages-artifact, without its floating nested action.
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: github-pages
          path: ${{ runner.temp }}/artifact.tar
          if-no-files-found: error
          retention-days: 1
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: tipjar-predeploy
          path: _predeploy/
          if-no-files-found: error
          retention-days: 1

  deploy:
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: github-pages
          path: _pages/
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: tipjar-predeploy
          path: _predeploy/
      - name: Recheck the exact artifact immediately before deployment
        env:
          SOURCE_COMMIT: ${{ needs.build.outputs.source_commit }}
          BOOTSTRAP: ${{ inputs.bootstrap == true }}
        shell: bash
        run: |
          flags=()
          if [ "$BOOTSTRAP" = true ]; then flags+=(--bootstrap); fi
          python3 _predeploy/tools/tipjar_board_deploy.py --artifact _pages/artifact.tar --source-commit "$SOURCE_COMMIT" "${flags[@]}"
      - name: Deploy reviewed artifact
        id: deployment
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4.0.5
        with:
          artifact_name: github-pages
