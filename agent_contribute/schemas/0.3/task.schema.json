{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External tip task 0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "source",
    "objective",
    "behavior_criteria",
    "code_locations",
    "constraints",
    "prohibited_changes",
    "validation",
    "prerequisites",
    "approval",
    "discovery",
    "done",
    "evidence",
    "questions",
    "execution",
    "scope",
    "source_review"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "issue",
        "issue_url",
        "issue_updated_at",
        "issue_sha256",
        "default_branch",
        "commit",
        "fetched_at",
        "instructions_sha256",
        "repository_id",
        "owner_id",
        "issue_id",
        "policy_sha256"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "issue_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "issue_updated_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "issue_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "fetched_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "instructions_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "owner_id": {
          "type": "integer",
          "minimum": 1
        },
        "issue_id": {
          "type": "integer",
          "minimum": 1
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "objective": {
      "type": "string",
      "maxLength": 100000
    },
    "behavior_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          }
        }
      },
      "maxItems": 100
    },
    "code_locations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000
      },
      "maxItems": 100
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000
      },
      "maxItems": 100
    },
    "prohibited_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000
      },
      "maxItems": 100
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv",
          "success",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000
            },
            "minItems": 1,
            "maxItems": 100
          },
          "success": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "kind": {
            "type": "string",
            "enum": [
              "tests",
              "check"
            ]
          }
        }
      },
      "maxItems": 100
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "satisfied",
              "blocked"
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 100000
          }
        }
      },
      "maxItems": 100
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "policy_path",
        "policy_commit",
        "matched_labels",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "approved",
            "unknown"
          ]
        },
        "policy_path": {
          "const": ".agent-contrib.json"
        },
        "policy_commit": {
          "type": "string",
          "maxLength": 100000
        },
        "matched_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "maxItems": 100
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "duplicate_prs",
        "warnings"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "duplicate_prs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "number",
              "url",
              "reason",
              "repository"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "type": "string",
                "maxLength": 100000
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100000
              },
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
                "maxLength": 200
              }
            }
          },
          "maxItems": 1000
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "maxItems": 100
        }
      }
    },
    "done": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria_ids",
        "validation_ids",
        "independent_review_required",
        "human_signoff_required"
      ],
      "properties": {
        "criteria_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "maxItems": 100
        },
        "validation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "maxItems": 100
        },
        "independent_review_required": {
          "const": true
        },
        "human_signoff_required": {
          "const": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "contract_hash_algorithm"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "contract_hash_algorithm": {
          "const": "sha256"
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000
      },
      "maxItems": 100
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "target_repository",
        "target_repository_id",
        "head_repository",
        "head_repository_id",
        "head_owner_id",
        "credential_actor_id",
        "head_ref",
        "base_ref",
        "requested_actions"
      ],
      "properties": {
        "mode": {
          "const": "external-tip"
        },
        "target_repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "target_repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "head_repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "head_repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "head_owner_id": {
          "type": "integer",
          "minimum": 1
        },
        "credential_actor_id": {
          "type": "integer",
          "minimum": 1
        },
        "head_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "base_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requested_actions": {
          "const": [
            "implement",
            "push_head",
            "create_draft"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "prohibited_paths"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "prohibited_paths": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "source_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_format",
        "inventory_sha256",
        "invitation_basis",
        "jar_state",
        "jar_sha256"
      ],
      "properties": {
        "inventory_format": {
          "const": 3
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "invitation_basis": {
          "type": "string",
          "enum": [
            "welcome",
            "explicit-undeclared"
          ]
        },
        "jar_state": {
          "type": "string",
          "enum": [
            "welcome",
            "undeclared"
          ]
        },
        "jar_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
