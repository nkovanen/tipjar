{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Exclusive local save of a public PR observation; grants no authority.",
  "type": "object",
  "properties": {
    "output": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "receipt": {
      "$ref": "#/$defs/contributionReceipt"
    },
    "warning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": [
    "output",
    "receipt",
    "warning"
  ],
  "additionalProperties": false,
  "$defs": {
    "contributionReceipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "tipjar-receipt"
        },
        "trust": {
          "const": "recorded-observation-not-proof"
        },
        "observed_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 27,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z(?![\\s\\S])"
        },
        "repository": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "full_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9_.-]{0,99}(?![\\s\\S])"
            }
          },
          "required": [
            "id",
            "full_name"
          ],
          "additionalProperties": false
        },
        "pull_request": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "author": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 44,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}(?:\\[bot\\])?(?![\\s\\S])"
                },
                "type": {
                  "enum": [
                    "User",
                    "Bot"
                  ]
                }
              },
              "required": [
                "id",
                "login",
                "type"
              ],
              "additionalProperties": false
            },
            "state": {
              "enum": [
                "open",
                "draft",
                "closed",
                "merged"
              ]
            },
            "draft": {
              "type": "boolean"
            },
            "head": {
              "type": "object",
              "properties": {
                "sha": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              },
              "required": [
                "sha",
                "ref"
              ],
              "additionalProperties": false
            },
            "base": {
              "type": "object",
              "properties": {
                "sha": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              },
              "required": [
                "sha",
                "ref"
              ],
              "additionalProperties": false
            },
            "merge": {
              "type": "object",
              "properties": {
                "merged": {
                  "type": "boolean"
                },
                "merged_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 27,
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z(?![\\s\\S])"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "closed_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 27,
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z(?![\\s\\S])"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "commit_sha": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "merged_by": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "login": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 44,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}(?:\\[bot\\])?(?![\\s\\S])"
                        },
                        "type": {
                          "enum": [
                            "User",
                            "Bot"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "login",
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "merged",
                "merged_at",
                "closed_at",
                "commit_sha",
                "merged_by"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "number",
            "url",
            "author",
            "state",
            "draft",
            "head",
            "base",
            "merge"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source": {
              "const": "github-rest-get"
            },
            "endpoints": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            },
            "non_atomic": {
              "const": true
            }
          },
          "required": [
            "source",
            "endpoints",
            "non_atomic"
          ],
          "additionalProperties": false
        },
        "refresh": {
          "const": "Run tipjar receipt for this PR with a new output path; snapshots never refresh automatically."
        }
      },
      "required": [
        "schema_version",
        "kind",
        "trust",
        "observed_at",
        "repository",
        "pull_request",
        "provenance",
        "refresh"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:agent-contrib:output:2:receipt"
}
