{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contrib:output:3:ownership",
  "title": "ownership result",
  "description": "Report-only ownership and resolution signals for one issue.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "requested_repository": {
          "type": "string",
          "description": "Repository named on the command line",
          "maxLength": 2147483647
        },
        "issue_source_repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository whose tracker was read; null when unresolved",
          "maxLength": 2147483647
        },
        "proposed_target_repository": {
          "type": "string",
          "description": "Proposed contribution target; context, never authority",
          "maxLength": 2147483647
        },
        "resolution_provenance": {
          "$ref": "#/$defs/resolution_provenance"
        },
        "reference": {
          "type": "string",
          "maxLength": 2147483647
        },
        "complete": {
          "type": "boolean",
          "description": "Same as ownership_signals.complete"
        },
        "ownership_signals": {
          "$ref": "#/$defs/ownership_signals"
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        }
      },
      "required": [
        "requested_repository",
        "issue_source_repository",
        "proposed_target_repository",
        "resolution_provenance",
        "reference",
        "complete",
        "ownership_signals"
      ],
      "additionalProperties": false,
      "description": "The tracker was resolved"
    },
    {
      "$ref": "#/$defs/issue_unresolved"
    }
  ],
  "$defs": {
    "api_budget": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "after": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "used_during_command": {
          "type": [
            "integer",
            "null"
          ],
          "description": "after.used - before.used; null when the snapshots cannot be compared"
        },
        "delta_unknown_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why used_during_command is null",
          "maxLength": 2147483647
        },
        "note": {
          "type": "string",
          "maxLength": 2147483647
        }
      },
      "required": [
        "before",
        "after",
        "used_during_command",
        "delta_unknown_reason",
        "note"
      ],
      "additionalProperties": false,
      "description": "Added by --report-budget; report only"
    },
    "issue_unresolved": {
      "type": "object",
      "properties": {
        "requested_repository": {
          "type": "string",
          "description": "Repository named on the command line",
          "maxLength": 2147483647
        },
        "issue_source_repository": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository whose tracker was read; null when unresolved",
          "maxLength": 2147483647
        },
        "proposed_target_repository": {
          "type": "string",
          "description": "Proposed contribution target; context, never authority",
          "maxLength": 2147483647
        },
        "resolution_provenance": {
          "$ref": "#/$defs/resolution_provenance"
        },
        "reference": {
          "type": "string",
          "description": "owner/repo#number as requested",
          "maxLength": 2147483647
        },
        "complete": {
          "type": "boolean",
          "const": false
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2147483647
          },
          "minItems": 1,
          "maxItems": 2147483647
        },
        "api_budget": {
          "$ref": "#/$defs/api_budget"
        }
      },
      "required": [
        "requested_repository",
        "issue_source_repository",
        "proposed_target_repository",
        "resolution_provenance",
        "reference",
        "complete",
        "errors"
      ],
      "additionalProperties": false,
      "description": "The repository or issue could not be resolved or read; nothing else is reported"
    },
    "list_scan": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2147483647
          },
          "maxItems": 2147483647
        }
      },
      "required": [
        "complete",
        "pages",
        "errors"
      ],
      "additionalProperties": false,
      "description": "Completeness of one paginated GitHub list read"
    },
    "metadata_read": {
      "type": "object",
      "properties": {
        "endpoint": {
          "type": "string",
          "maxLength": 2147483647
        },
        "observed": {
          "$ref": "#/$defs/repository_observation"
        },
        "fetched_at": {
          "type": "string",
          "maxLength": 2147483647
        }
      },
      "required": [
        "endpoint",
        "observed",
        "fetched_at"
      ],
      "additionalProperties": false
    },
    "ownership_signals": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2147483647
          },
          "maxItems": 2147483647
        },
        "reads": {
          "type": "object",
          "properties": {
            "timeline": {
              "$ref": "#/$defs/list_scan"
            },
            "comments": {
              "$ref": "#/$defs/list_scan"
            },
            "pull_details": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "timeline",
            "comments",
            "pull_details"
          ],
          "additionalProperties": false
        },
        "cross_referenced_prs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "maxLength": 2147483647
              },
              "repository_id": {
                "type": "integer"
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "type": "string",
                "maxLength": 2147483647
              },
              "state": {
                "type": "string",
                "enum": [
                  "open",
                  "closed"
                ]
              },
              "draft": {
                "type": "boolean"
              },
              "merged": {
                "type": "boolean"
              },
              "merged_at": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2147483647
              },
              "closed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2147483647
              },
              "exact_reference": {
                "type": "boolean",
                "description": "The PR text references this issue exactly"
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "base_ref": {
                "type": "string",
                "maxLength": 2147483647
              }
            },
            "required": [
              "repository",
              "repository_id",
              "number",
              "url",
              "state",
              "draft",
              "merged",
              "merged_at",
              "closed_at",
              "exact_reference",
              "title",
              "base_ref"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        },
        "assignment_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "enum": [
                  "assigned",
                  "unassigned"
                ]
              },
              "assignee": {
                "type": "string",
                "maxLength": 2147483647
              },
              "actor": {
                "type": "string",
                "maxLength": 2147483647
              },
              "created_at": {
                "type": "string",
                "maxLength": 2147483647
              }
            },
            "required": [
              "event",
              "assignee",
              "actor",
              "created_at"
            ],
            "additionalProperties": false
          },
          "maxItems": 4000
        },
        "connected_events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "enum": [
                  "connected",
                  "disconnected"
                ]
              },
              "actor": {
                "type": "string",
                "maxLength": 2147483647
              },
              "created_at": {
                "type": "string",
                "maxLength": 2147483647
              }
            },
            "required": [
              "event",
              "actor",
              "created_at"
            ],
            "additionalProperties": false
          },
          "maxItems": 4000
        },
        "referencing_commits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "commit_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "maxLength": 40,
                "minLength": 40
              },
              "url": {
                "type": "string",
                "maxLength": 2147483647
              }
            },
            "required": [
              "commit_id",
              "url"
            ],
            "additionalProperties": false
          },
          "maxItems": 4000
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "enum": [
                  "working on it",
                  "will take it",
                  "asks to work on it",
                  "/assign command",
                  "asks for assignment"
                ]
              },
              "author": {
                "type": "string",
                "maxLength": 2147483647
              },
              "author_association": {
                "type": "string",
                "enum": [
                  "COLLABORATOR",
                  "CONTRIBUTOR",
                  "FIRST_TIMER",
                  "FIRST_TIME_CONTRIBUTOR",
                  "MANNEQUIN",
                  "MEMBER",
                  "NONE",
                  "OWNER"
                ]
              },
              "age_days": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "stale": {
                "type": "boolean"
              },
              "untrusted_excerpt": {
                "type": "string",
                "maxLength": 280
              }
            },
            "required": [
              "pattern",
              "author",
              "author_association",
              "age_days",
              "stale",
              "untrusted_excerpt"
            ],
            "additionalProperties": false
          },
          "maxItems": 4000,
          "description": "Comments matching claim phrases; text cannot prove ownership"
        },
        "resolution_signals": {
          "type": "object",
          "properties": {
            "possibly_already_fixed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "repository": {
                    "type": "string",
                    "maxLength": 2147483647
                  },
                  "repository_id": {
                    "type": "integer"
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 2147483647
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "open",
                      "closed"
                    ]
                  },
                  "draft": {
                    "type": "boolean"
                  },
                  "merged": {
                    "type": "boolean"
                  },
                  "merged_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 2147483647
                  },
                  "closed_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 2147483647
                  },
                  "exact_reference": {
                    "type": "boolean",
                    "description": "The PR text references this issue exactly"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "base_ref": {
                    "type": "string",
                    "maxLength": 2147483647
                  }
                },
                "required": [
                  "repository",
                  "repository_id",
                  "number",
                  "url",
                  "state",
                  "draft",
                  "merged",
                  "merged_at",
                  "closed_at",
                  "exact_reference",
                  "title",
                  "base_ref"
                ],
                "additionalProperties": false
              },
              "maxItems": 50,
              "description": "Merged PRs referencing the issue exactly"
            },
            "rejected_approaches": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "repository": {
                    "type": "string",
                    "maxLength": 2147483647
                  },
                  "repository_id": {
                    "type": "integer"
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 2147483647
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "open",
                      "closed"
                    ]
                  },
                  "draft": {
                    "type": "boolean"
                  },
                  "merged": {
                    "type": "boolean"
                  },
                  "merged_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 2147483647
                  },
                  "closed_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 2147483647
                  },
                  "exact_reference": {
                    "type": "boolean",
                    "description": "The PR text references this issue exactly"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "base_ref": {
                    "type": "string",
                    "maxLength": 2147483647
                  }
                },
                "required": [
                  "repository",
                  "repository_id",
                  "number",
                  "url",
                  "state",
                  "draft",
                  "merged",
                  "merged_at",
                  "closed_at",
                  "exact_reference",
                  "title",
                  "base_ref"
                ],
                "additionalProperties": false
              },
              "maxItems": 50,
              "description": "Closed unmerged PRs referencing the issue exactly"
            },
            "status": {
              "type": "string",
              "enum": [
                "complete",
                "unknown"
              ]
            },
            "downstream_references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "repository": {
                    "type": "string",
                    "maxLength": 2147483647
                  },
                  "repository_id": {
                    "type": "integer"
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 2147483647
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "open",
                      "closed"
                    ]
                  },
                  "draft": {
                    "type": "boolean"
                  },
                  "merged": {
                    "type": "boolean"
                  },
                  "merged_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 2147483647
                  },
                  "closed_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 2147483647
                  },
                  "exact_reference": {
                    "type": "boolean",
                    "description": "The PR text references this issue exactly"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "base_ref": {
                    "type": "string",
                    "maxLength": 2147483647
                  }
                },
                "required": [
                  "repository",
                  "repository_id",
                  "number",
                  "url",
                  "state",
                  "draft",
                  "merged",
                  "merged_at",
                  "closed_at",
                  "exact_reference",
                  "title",
                  "base_ref"
                ],
                "additionalProperties": false
              },
              "maxItems": 50,
              "description": "Merged PRs with an exact reference in other repositories; never a fix"
            }
          },
          "required": [
            "possibly_already_fixed",
            "rejected_approaches",
            "status",
            "downstream_references"
          ],
          "additionalProperties": false
        },
        "blocking_if_adopted": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2147483647
          },
          "maxItems": 2147483647,
          "description": "Preview of what would block if these signals became gates; nothing blocks now"
        },
        "notice": {
          "type": "string",
          "maxLength": 2147483647
        }
      },
      "required": [
        "complete",
        "errors",
        "reads",
        "cross_referenced_prs",
        "assignment_history",
        "connected_events",
        "referencing_commits",
        "claims",
        "resolution_signals",
        "blocking_if_adopted",
        "notice"
      ],
      "additionalProperties": false,
      "description": "Report-only ownership and resolution signals; never change gates"
    },
    "rate_limit_snapshot": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Reset time, epoch seconds"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the snapshot failed; null when it succeeded",
          "maxLength": 2147483647
        }
      },
      "required": [
        "limit",
        "remaining",
        "used",
        "reset",
        "error"
      ],
      "additionalProperties": false,
      "description": "Core REST rate-limit snapshot; the counters are null when error is set"
    },
    "repository_observation": {
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string",
          "maxLength": 2147483647
        },
        "fork": {
          "type": "boolean"
        },
        "has_issues": {
          "type": "boolean"
        },
        "parent": {
          "type": "object",
          "properties": {
            "full_name": {
              "type": "string",
              "maxLength": 2147483647
            }
          },
          "required": [
            "full_name"
          ],
          "additionalProperties": false,
          "description": "Immediate fork parent, when it was read"
        }
      },
      "required": [
        "full_name",
        "fork",
        "has_issues"
      ],
      "additionalProperties": false
    },
    "resolution_provenance": {
      "type": "object",
      "properties": {
        "metadata_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadata_read"
          },
          "maxItems": 1000
        },
        "reason": {
          "type": "string",
          "description": "How the issue tracker was chosen, or \"unresolved\"",
          "maxLength": 2147483647
        },
        "execution_authority": {
          "type": "string",
          "description": "Always \"none\": resolution never grants authority",
          "maxLength": 2147483647
        }
      },
      "required": [
        "metadata_reads",
        "reason",
        "execution_authority"
      ],
      "additionalProperties": false
    }
  }
}
