{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contrib:output:4:instructions",
  "title": "instructions result",
  "description": "Installed workflow, versions and packaged resources.",
  "type": "object",
  "properties": {
    "cli_version": {
      "type": "string",
      "maxLength": 2147483647
    },
    "supported_schema_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2147483647
      },
      "description": "Task/evidence schema versions this CLI accepts",
      "maxItems": 1000
    },
    "supported_host_context_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2147483647
      },
      "maxItems": 1000
    },
    "host_authorization": {
      "type": "string",
      "maxLength": 2147483647
    },
    "workflow_markdown": {
      "type": "string",
      "maxLength": 1000000,
      "description": "The installed workflow (instructions.md)"
    },
    "resources": {
      "type": "object",
      "properties": {
        "task_schema": {
          "type": "string",
          "maxLength": 2147483647
        },
        "evidence_schema": {
          "type": "string",
          "maxLength": 2147483647
        },
        "task_schema_0.2": {
          "type": "string",
          "maxLength": 2147483647
        },
        "evidence_schema_0.2": {
          "type": "string",
          "maxLength": 2147483647
        },
        "host_context_schema": {
          "type": "string",
          "maxLength": 2147483647
        },
        "host_context_schema_0.2": {
          "type": "string",
          "maxLength": 2147483647
        },
        "output_schemas": {
          "type": "string",
          "description": "Package directory of these output schemas; agent-contrib schema COMMAND prints one",
          "maxLength": 2147483647
        },
        "task_schema_0.3": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "external_context_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "draft_payload_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        }
      },
      "required": [
        "task_schema",
        "evidence_schema",
        "task_schema_0.2",
        "evidence_schema_0.2",
        "host_context_schema",
        "host_context_schema_0.2",
        "output_schemas",
        "task_schema_0.3",
        "external_context_schema",
        "draft_payload_schema"
      ],
      "additionalProperties": false,
      "description": "Package-relative resource paths"
    },
    "output_schema_version": {
      "type": "string",
      "description": "Version of the output schemas, independent of task/evidence schema versions",
      "maxLength": 2147483647
    },
    "automatic_updates": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "cli_version",
    "supported_schema_versions",
    "supported_host_context_versions",
    "host_authorization",
    "workflow_markdown",
    "resources",
    "output_schema_version",
    "automatic_updates"
  ],
  "additionalProperties": false,
  "$defs": {
    "api_budget": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "after": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "used_during_command": {
          "type": [
            "integer",
            "null"
          ],
          "description": "after.used - before.used; null when the snapshots cannot be compared"
        },
        "delta_unknown_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why used_during_command is null",
          "maxLength": 2147483647
        },
        "note": {
          "type": "string",
          "maxLength": 2147483647
        }
      },
      "required": [
        "before",
        "after",
        "used_during_command",
        "delta_unknown_reason",
        "note"
      ],
      "additionalProperties": false,
      "description": "Added by --report-budget; report only"
    },
    "rate_limit_snapshot": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Reset time, epoch seconds"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the snapshot failed; null when it succeeded",
          "maxLength": 2147483647
        }
      },
      "required": [
        "limit",
        "remaining",
        "used",
        "reset",
        "error"
      ],
      "additionalProperties": false,
      "description": "Core REST rate-limit snapshot; the counters are null when error is set"
    }
  }
}
