  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-contrib:output:4:jar",
  "description": "Pinned versioned invitation source; grants no authority.",
  "$defs": {
    "tipjar_manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1"
        },
        "status": {
          "type": "string",
          "enum": [
            "welcome",
            "closed"
          ]
        },
        "wanted": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          }
        },
        "boundaries": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "status"
      ],
      "additionalProperties": false
    },
    "api_budget": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "after": {
          "$ref": "#/$defs/rate_limit_snapshot"
        },
        "used_during_command": {
          "type": [
            "integer",
            "null"
          ],
          "description": "after.used - before.used; null when the snapshots cannot be compared"
        },
        "delta_unknown_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why used_during_command is null",
          "maxLength": 2147483647
        },
        "note": {
          "type": "string",
          "maxLength": 2147483647
        }
      },
      "required": [
        "before",
        "after",
        "used_during_command",
        "delta_unknown_reason",
        "note"
      ],
      "additionalProperties": false,
      "description": "Added by --report-budget; report only"
    },
    "rate_limit_snapshot": {
      "type": "object",
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "remaining": {
          "type": [
            "integer",
            "null"
          ]
        },
        "used": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Reset time, epoch seconds"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the snapshot failed; null when it succeeded",
          "maxLength": 2147483647
        }
      },
      "required": [
        "limit",
        "remaining",
        "used",
        "reset",
        "error"
      ],
      "additionalProperties": false,
      "description": "Core REST rate-limit snapshot; the counters are null when error is set"
    }
  }
}
